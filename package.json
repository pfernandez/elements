{
  "name": "elements-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/elements"
  ],
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "build": "vite build",
    "build:pages": "vite build --base=/elements/ && node scripts/build-demo.js",
    "preview": "vite preview",
    "sync:readmes": "node scripts/sync-readmes.js",
    "typecheck": "npm --prefix packages/elements run -s typecheck",
    "build:types": "npm --prefix packages/elements run -s build:types",
    "test": "npm --prefix packages/elements test",
    "test:browser": "node scripts/test-browser.js",
    "test:browsers": "node scripts/test-browsers.mjs",
    "test:pages": "node scripts/test-pages.js",
    "test:packages": "node scripts/test-packages.js",
    "test:coverage": "npm --prefix packages/elements run -s test:coverage",
    "x3dom:typecheck": "npm run -s typecheck",
    "x3dom:build:types": "npm run -s build:types",
    "x3dom:test": "npm run -s 3d:test",
    "x3dom:test:coverage": "npm run -s 3d:test:coverage",
    "fetch:x3dom-src": "npm --prefix packages/elements run -s fetch:x3dom-src",
    "x3dom:fetch:x3dom-src": "npm run -s fetch:x3dom-src",
    "3d:typecheck": "npm run -s typecheck",
    "3d:build:types": "npm run -s build:types",
    "3d:test": "npm --prefix packages/elements run -s 3d:test",
    "3d:test:coverage": "npm --prefix packages/elements run -s 3d:test:coverage",
    "3d:fetch:x3dom-src": "npm run -s fetch:x3dom-src",
    "pkg:report": "node scripts/package-report.js packages/elements",
    "x3dom:pkg:report": "npm run -s pkg:report",
    "3d:pkg:report": "npm run -s pkg:report"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "eslint": "^9.39.2",
    "globals": "^14.0.0",
    "markdown-it": "^15.0.2",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "version": "0.1.0"
}
