{
  "name": "@pfern/elements",
  "version": "0.3.0",
  "description": "A functional UI library built around recursive composition and declarative state transitions.",
  "author": "Paul Fernandez",
  "license": "MIT",
  "type": "module",
  "types": "./types/elements.d.ts",
  "exports": {
    ".": {
      "types": "./types/elements.d.ts",
      "import": "./elements.js",
      "default": "./elements.js"
    },
    "./mathml": {
      "types": "./types/mathml.d.ts",
      "import": "./mathml.js",
      "default": "./mathml.js"
    },
    "./html": {
      "types": "./types/html.d.ts",
      "import": "./html.js",
      "default": "./html.js"
    },
    "./svg": {
      "types": "./types/svg.d.ts",
      "import": "./svg.js",
      "default": "./svg.js"
    }
  },
  "files": [
    "./elements.js",
    "./html.js",
    "./svg.js",
    "./mathml.js",
    "./env.d.ts",
    "./src",
    "./types"
  ],
  "scripts": {
    "clean:types": "node scripts/clean-types.js",
    "build:types": "node scripts/build-types.js",
    "typecheck": "node scripts/typecheck.js",
    "prepack": "npm run -s build:types",
    "test": "node --test test/*.test.* --test-reporter spec",
    "test:coverage": "node scripts/test-coverage.js",
    "gen:vocabularies": "node scripts/generate-vocabularies.js"
  },
  "keywords": [
    "ui",
    "functional",
    "declarative",
    "frontend",
    "vdom",
    "recursive",
    "state-transitions",
    "dom",
    "html",
    "svg",
    "ssr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pfernandez/elements.git",
    "directory": "packages/elements"
  },
  "homepage": "https://pfernandez.github.io/elements/",
  "bugs": {
    "url": "https://github.com/pfernandez/elements/issues"
  }
}
