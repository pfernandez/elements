{
  "name": "@pfern/elements",
  "version": "0.3.0",
  "description": "A functional UI library built around recursive composition and declarative state transitions.",
  "author": "Paul Fernandez",
  "license": "MIT",
  "type": "module",
  "types": "./types/elements.d.ts",
  "exports": {
    ".": {
      "types": "./types/elements.d.ts",
      "import": "./elements.js",
      "default": "./elements.js"
    },
    "./mathml": {
      "types": "./types/mathml.d.ts",
      "import": "./mathml.js",
      "default": "./mathml.js"
    },
    "./html": {
      "types": "./types/html.d.ts",
      "import": "./html.js",
      "default": "./html.js"
    },
    "./svg": {
      "types": "./types/svg.d.ts",
      "import": "./svg.js",
      "default": "./svg.js"
    },
    "./3d": {
      "types": "./types/3d.d.ts",
      "import": "./3d.js",
      "default": "./3d.js"
    }
  },
  "files": [
    "./elements.js",
    "./html.js",
    "./svg.js",
    "./mathml.js",
    "./3d.js",
    "./3d.md",
    "./MIGRATION.md",
    "./env.d.ts",
    "./src",
    "./types",
    "./vendor"
  ],
  "scripts": {
    "clean:types": "node scripts/clean-types.js",
    "build:types": "npm run -s clean:types && node scripts/generate-x3d.js --runtime && tsc -p tsconfig.json && node scripts/generate-x3d.js --types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run -s build:types",
    "test": "node --test --test-reporter=spec test/*.test.js test/3d/*.test.js",
    "test:coverage": "node scripts/test-coverage.js",
    "3d:test": "node --test --test-reporter=spec test/3d/*.test.js",
    "3d:test:coverage": "node scripts/test-3d-coverage.js",
    "fetch:x3dom-src": "node scripts/fetch-x3dom-src.js"
  },
  "keywords": [
    "ui",
    "functional",
    "declarative",
    "frontend",
    "vdom",
    "recursive",
    "state-transitions",
    "dom",
    "html",
    "svg",
    "ssr",
    "x3d",
    "x3dom"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pfernandez/elements.git",
    "directory": "packages/elements"
  },
  "homepage": "https://pfernandez.github.io/elements/",
  "bugs": {
    "url": "https://github.com/pfernandez/elements/issues"
  }
}
